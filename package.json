{
  "name": "omts-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "node scripts/run-api.mjs",
    "start:api": "node scripts/run-api.mjs --production",
    "setup:api": "node scripts/setup-api-local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests/fixtures/cookie-browser --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:api-roles": "node scripts/test-api-role-matrix.mjs",
    "test:redis": "node scripts/test-session-redis.mjs",
    "test:session-pages": "node scripts/test-session-pages.mjs",
    "test:boundary": "node scripts/test-server-boundary.mjs",
    "test:serialization": "node scripts/test-server-serialization.mjs",
    "test:cookies": "node scripts/test-cookie-fixture.mjs",
    "test:cookies:serve": "node scripts/test-cookie-fixture.mjs --serve"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@redis/client": "6.3.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
