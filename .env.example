# Source selection is server-only. Keep mock while reviewing existing UI.
OMTS_DATA_SOURCE=mock

# Public browser map key. Use a dedicated VietMap key restricted to Web domains.
# Match the Mobile/Zalo map provider; never use a server credential here.
# NEXT_PUBLIC_VIETMAP_API_KEY=

# New purchasing contract (per-line raft, supplier-level payments/debts).
# Set before build when the backend includes PURCHASE-01..06 of SRS 27/10.
# NEXT_PUBLIC_OMTS_PURCHASING_CONTRACT=v2

# API configuration: source=api requires both values, no public URL alias.
# For the local tester workspace, run npm run setup:api then build/start:api.
# OMTS_API_BASE_URL=http://127.0.0.1:8080
# OMTS_API_TIMEOUT_MS=5000
# Outside local dev the API must be https. A staging API without TLS can be allowed with exactly "true";
# passwords and tokens then travel in clear text, so remove it as soon as the API has HTTPS.
# OMTS_API_ALLOW_INSECURE_HTTP=true
# Login, password change, sessions and supported business screens use the BFF.
# Self-registration does not exist on the Web: trader accounts are created through the Mini App.

# Key ring that seals the short-lived verification cookie (password recovery and contact change codes).
# Generate real 32-byte secrets outside Git. Keep older key IDs during rotation so a flow in progress still opens.
# Every instance of the Web app must share the same ring.
# OMTS_WEB_SESSION_ACTIVE_KEY_ID=local-key-1
# OMTS_WEB_SESSION_KEYRING=local-key-1=<base64url-32-byte-secret>
# Web sign-in: the access token and the refresh token are HttpOnly cookies and the BFF keeps no session
# record and needs no database or cache.

# The API trusts the end-user address and browser the BFF reports only together with this shared secret.
# It must equal BffClient:SharedSecret on the API (at least 32 characters outside Development). Leave unset
# and the API sees the BFF address for every user. Generate it outside Git; never put it in a NEXT_PUBLIC_ variable.
# OMTS_BFF_SHARED_SECRET=
# Where the end-user address comes from. Only a value the deployment controls is trusted:
#   none          report no address (default)
#   vercel        x-vercel-forwarded-for, overwritten by the platform edge
#   real-ip       x-real-ip, set by your own reverse proxy (it must overwrite any client-sent copy)
#   forwarded-for the Nth entry from the right of x-forwarded-for, N = OMTS_WEB_TRUSTED_PROXY_HOPS
# The leftmost x-forwarded-for entry is client-supplied and is never used.
# OMTS_WEB_CLIENT_IP_SOURCE=none
# OMTS_WEB_TRUSTED_PROXY_HOPS=1

# API mode uses this Web cookie configuration at request time.
# Explicit local HTTP profile (development/test, canonical loopback hosts only):
# OMTS_WEB_ORIGIN=http://localhost:3000
# OMTS_WEB_COOKIE_PROFILE=http-loopback-dev
# For HTTPS dev/QA/production use profile=https and the exact HTTPS Web origin.
# This is NOT the backend API origin and never comes from Host/forwarded headers.

